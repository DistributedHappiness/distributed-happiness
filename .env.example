# ==============================================================================
# Distribute Happiness Website — Environment Variables
# ==============================================================================

# Supabase Database & Auth (Required for production live data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Store Identity & WhatsApp
NEXT_PUBLIC_STORE_NAME="Distribute Happiness"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
NEXT_PUBLIC_WEBSITE_URL="https://distributehappiness.com"

# Email Notifications (Optional - Resend integration. Graceful fallback if omitted)
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_FROM_EMAIL=orders@distributehappiness.com

# Payment Gateway (Optional - Razorpay integration)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key